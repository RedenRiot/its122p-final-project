{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "book-marketplace-backend/**"
    }
  },
  "routes": [
    { "src": "/robots.txt", "dest": "/api/index.php?__route=robots.php" },
    { "src": "/sitemap.xml", "dest": "/api/index.php?__route=sitemap.php" },
    { "src": "/api/?(.*)", "dest": "/api/index.php?__route=$1" },
    { "src": "/", "dest": "/book-marketplace-frontend/index.html" },
    { "src": "/(.*)", "dest": "/book-marketplace-frontend/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
