{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "book-marketplace-backend/api/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "book-marketplace-backend/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/book-marketplace-backend/api/$1"
    },
    {
      "src": "/backend-status",
      "dest": "/book-marketplace-backend/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/book-marketplace-frontend/$1"
    }
  ]
}
